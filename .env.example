# Ficheiro de exemplo de variáveis de ambiente para o Oasis Trading System
# Copie este ficheiro para .env e preencha com os seus valores locais.
# NUNCA comite o seu ficheiro .env!

# --- Dependências Externas ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=market-data.trades.normalized
RAW_MARKET_TOPIC=market-data.trades.coinbase
NORMALIZED_MARKET_TOPIC=market-data.trades.normalized
CONTROL_COMMAND_TOPIC=control.commands
REDIS_ADDR=redis://127.0.0.1:6380/0
REDIS_URL=redis://127.0.0.1:6380/0
RISK_REDIS_ADDR=redis://127.0.0.1:6380/0

# --- Coinbase Connector (Rust) ---
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
CONNECTOR_METRICS_PORT=9091

# --- Strategy Framework (Python) ---
STRATEGY_METRICS_PORT=9092
MARKET_DATA_TOPIC=market-data.trades.coinbase
STRATEGY_CONSUMER_GROUP=strategy-framework-group
SYMBOL=BTC-USD

# --- Risk Engine (Rust) ---
RISK_ENGINE_GRPC_ADDR=[::1]:50051
RISK_METRICS_PORT=9093
RISK_REQUIRE_CASH_BALANCE=1   # 1 para exigir saldo real disponível; 0 para desativar (não recomendado em produção)
RISK_ALLOW_SHORTS=0           # 1 para permitir posições vendidas; 0 para bloquear
RISK_REAL_CASH_USD=           # opcional: saldo real inicial (preenchido no Redis/memória se informado)
SIMULATION_SOURCE=paper       # paper|sandbox para forçar modo simulado/paper (desativado para produção)

# --- Order Manager (Go) ---
ORDER_MANAGER_GRPC_ADDR=[::1]:50052
ORDER_MANAGER_MODE=paper  # valores: paper|real
PAPER_INITIAL_CASH_USD=100000   # saldo inicial padrão para paper/sandbox se carteira estiver vazia
COINBASE_API_BASE_URL=https://api.exchange.coinbase.com  # ajuste conforme API vigente
ORDER_MANAGER_COINBASE_VARIANT=advanced_trade   # advanced_trade|exchange
ORDER_MANAGER_COINBASE_ENV=prod                 # prod|sandbox
ORDER_MANAGER_METRICS_PORT=9094
# Token obrigatório para gRPC entre Risk Engine e Order Manager (>=16 chars)
ORDER_MANAGER_GRPC_TOKEN=defina-token-grpc
# Polling de saldo/contas (apenas advanced_trade). Use 1 para ativar.
ORDER_MANAGER_RECONCILE_ENABLED=1
ORDER_MANAGER_RECONCILE_INTERVAL_S=30
ORDER_MANAGER_STATUS_POLL_ENABLED=1
ORDER_MANAGER_STATUS_POLL_INTERVAL_S=15

# --- Control Center API (Go) ---
CONTROL_CENTER_API_PORT=8080
# Obrigatório: defina usuário/senha fortes (>=3 / >=10 chars) e JWT_SECRET >=16 chars
CONTROL_CENTER_API_USER=defina-usuario-seguro
CONTROL_CENTER_API_PASSWORD=defina-senha-segura
JWT_SECRET=defina-um-segredo-unico-e-longo
# Lista separada por vírgulas; obrigatório (sem wildcard '*')
CONTROL_CENTER_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CONTROL_CENTER_API_URL=http://localhost:8080
# Obrigatório: token interno longo e único para /internal/v1/*
CONTROL_CENTER_INTERNAL_TOKEN=defina-token-interno
DATABASE_URL=postgres://postgres:postgres@localhost:5432/oasis
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# Utilize \\n para representar quebras de linha no ficheiro .env
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nMIIEv...\\n-----END PRIVATE KEY-----\\n"
FIREBASE_COLLECTION_REAL_OPERATIONS=real_operations
FIREBASE_COLLECTION_REAL_CONFIGS=strategy_configs
FIREBASE_COLLECTION_USERS=users

# --- Control Center Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Strategy Framework -> Control Center callbacks ---
# (Reutiliza CONTROL_CENTER_API_URL/CONTROL_CENTER_INTERNAL_TOKEN definidos acima)

# --- CREDENCIAIS DE PRODUÇÃO (NUNCA COMITAR!) ---
COINBASE_API_KEY=YOUR_API_KEY_HERE
COINBASE_API_SECRET=YOUR_API_SECRET_HERE
COINBASE_API_PASSPHRASE=YOUR_PASSPHRASE_HERE
